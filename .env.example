DATABASE_URL=postgresql+psycopg://favorites_hub:change-me@127.0.0.1:5432/favorites_hub
ADMIN_API_KEY=replace-with-a-long-random-admin-key
CORS_ALLOWED_ORIGINS=chrome-extension://your-extension-id

AI_PROVIDER=openai
AI_MODEL=gpt-5.6-luna
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_BASE_URL=
AI_REASONING_EFFORT=low
AI_TIMEOUT_SECONDS=120
AI_SEARCH_BATCH_SIZE=40
AI_MAX_OUTPUT_TOKENS=4096
AI_LOG_MODEL_PAYLOADS=false

# 切换回 DeepSeek 时配置：AI_PROVIDER=deepseek、AI_MODEL 和以下两项。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
